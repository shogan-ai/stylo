opam-version: "2.0"
synopsis: "Styling O(x)Caml code, Jane Street style"
depends: [
  "dune" {>= "3.15"}
  "stylo-lib" {= version}
  "cmdliner" {>= "2.1.0"}
  "menhir" {>= "20260209"}
  "astring"
  "camlp-streams"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
